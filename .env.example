# URL du backend FastAPI. Copiez ce fichier en ".env" et ajustez la valeur.
VITE_API_URL=http://localhost:8000

# Supervision des erreurs (Sentry) — laissez vide en dev, aucun effet sans
# valeur. Créez un projet gratuit sur sentry.io (type "React") pour obtenir
# ce DSN, puis reconstruisez le site (VITE_* est intégré au build, pas lu
# à l'exécution).
VITE_SENTRY_DSN=
